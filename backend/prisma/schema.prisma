
generator client {
  provider = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  TRAINER
  ADMIN
}

model User {
  id Int @id @default(autoincrement())
  login String @unique
  passwordHash String
  role Role @default(TRAINER)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  @@map("users")
}