
generator client {
  provider = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  TRAINER
  ADMIN
}

model User {
  id Int @id @default(autoincrement())
  login String @unique
  passwordHash String
  role Role @default(TRAINER)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  trainerId Int?    @unique
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  @@map("users")
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum ChildStatus {
  ACTIVE
  INACTIVE
}

model Group {
  id       Int     @id @default(autoincrement())
  name     String
  status   GroupStatus @default(ACTIVE)

  children Child[]
  trainers GroupTrainer[]

  @@map("groups")
}

model Child {
  id         Int       @id @default(autoincrement())
  groupId    Int
  lastName   String
  firstName  String
  middleName String?
  birthDate  DateTime? @db.Date
  heightCm   Int?
  shoeSize   Decimal?  @db.Decimal(3, 1)
  status     ChildStatus    @default(ACTIVE)

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@map("children")
}

model Trainer {
  id             Int     @id @default(autoincrement())
  lastName       String
  firstName      String
  middleName     String?
  phone          String
  specialization String

  user User?
  groups GroupTrainer[]
  @@map("trainers")
}

model GroupTrainer {
  groupId   Int
  trainerId Int

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([groupId, trainerId])
  @@index([trainerId])
  @@map("group_trainers")
}